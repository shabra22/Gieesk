<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#0A0A09</item>
        <!-- Draw behind the status bar, the gesture bar and the camera
             cutout, so a full-screen video has no black bands around it.
             The web layout keeps its own padding out of those areas via
             the safe-area insets. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Text editing inside the WebView.

             This theme is the one MainActivity runs under, and it never
             set an accent, so every input inherited AppCompat's teal: a
             teal caret and teal selection handles in a gold-and-charcoal
             app. colorControlActivated is what the WebView's own handle
             and cursor drawables are tinted from.

             The app is dark whatever the phone's setting, so force the
             dark night mode too — under DayNight a phone in light mode
             was handing the WebView light-theme editing widgets over a
             near-black page. -->
        <item name="colorAccent">@color/gieeskGold</item>
        <item name="colorControlActivated">@color/gieeskGold</item>
        <item name="android:colorControlActivated">@color/gieeskGold</item>
        <item name="android:colorAccent">@color/gieeskGold</item>
        <item name="android:textColorHighlight">#59D4A039</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
