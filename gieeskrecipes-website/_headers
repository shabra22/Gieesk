# Recipe detail — content can change (photos, edits); cache but revalidate
/data/recipes/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Catalogue — changes when recipes are added; revalidate daily
/data/index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=604800
/css/*
  Cache-Control: public, max-age=604800

# Android App Links: Google's verifier fetches this over HTTPS and wants
# JSON. Short cache so a fingerprint change (a new signing key) is picked
# up the same day rather than weeks later.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
